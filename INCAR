!GaAs
 ENCUT = 250             !cutoff energy for plane waves
 EDIFF = 1e-5            !energy difference for electronic convergence
 ISMEAR = 0              !gaussian smearing
 SIGMA = 0.01 
 ISTART = 0              !Calculation is started from scratch
	
!Parallelization
 NCORE = 1               !number of cores per orbital
 KPAR = 4                !number of kpoints to be treated in parallel

!Output
 LWAVE = False           !wavecar is not written
 LCHARG = False          !chargecar is written

!Wannier90
 LWANNIER90_RUN = TRUE   !start wannier90 after vasp run
 LWRITE_UNK = TRUE       !unk files are written, needed for WF plotting
 NUM_WANN = 8
 WANNIER90_WIN = "
  !General Options
   num_wann = 8                         !number of wannier functions
   num_iter = 0                         !number of iterations to minimize spread
   write_hr = True                      !write *_hr.dat output file
 
  !Disentanglement
   dis_win_max = 15                     !upper bound of energy window for disentanglement
   dis_win_min = -13                    !lower bound of energy window for disentanglement
   dis_froz_max = 5                     !upper bound for frozen states (not disentangled)
   dis_froz_min = -13                   !lower bound for frozen states (not disentangled)

  !Plotting
   wannier_plot = True                  !WF plot file are written
   wannier_plot_format = xcrysden       !WF plotting format is *.xsf

  !Initial guess for WFs
   begin projections
    Ga:l=0;l=1                          !projection of four sp3 orbitals
    As:l=0;l=1                          !projection of four sp3 orbitals
   end projections
 "